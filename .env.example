# Supabase -- for local dev, run `npx supabase start` first and copy these
# from its output (or `npx supabase status`). This project's config.toml
# uses non-default ports, so the local API URL is http://127.0.0.1:55321,
# not the Supabase CLI's usual :54321.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2 (card image storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend (transactional email)
RESEND_API_KEY=

# PokemonTCG API (key recommended, not required)
POKEMONTCG_API_KEY=

# Marketplace Sync -- per-store Shopify/TCGplayer credentials are entered via
# the Settings UI and stored in marketplace_credentials, not here. These are
# app-level config only.
CRON_SECRET=
# Overridable API base URLs -- used to point at a local mock server for
# verification without changing any client code; leave unset in production.
SHOPIFY_API_BASE_URL=
TCGPLAYER_API_BASE_URL=
SHIPPO_API_BASE_URL=

# Kiosk -- signs the lower-trust kiosk-session cookie (separate from
# Supabase Auth). A long random string, server-only, never exposed to the
# client.
KIOSK_SESSION_SECRET=
